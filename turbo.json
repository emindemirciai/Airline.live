{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "cacheDir": "../.turbo-cache/havayolu",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", "tools/fixtures/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["APP_ENV", "GIT_SHA", "BUILD_TIME"]
    },
    "@havayolu/web#build": {
      "dependsOn": ["^build", "@havayolu/web#typecheck"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["APP_ENV", "GIT_SHA", "BUILD_TIME"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/src/**"]
    },
    "typecheck": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/src/**"]
    },
    "test": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/src/**"]
    },
    "@havayolu/tools#test": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/shared/src/**",
        "$TURBO_ROOT$/packages/geo/src/**",
        "$TURBO_ROOT$/packages/providers/src/**",
        "$TURBO_ROOT$/packages/db/src/**",
        "$TURBO_ROOT$/apps/worker/src/**",
        "$TURBO_ROOT$/e2e/country-label-expectations.ts",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/apps/web/src/components/map/labels.ts"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "TEST_DATABASE_URL",
        "TEST_DATABASE_ADMIN_URL",
        "TEST_REDIS_QUEUE_URL",
        "TEST_REDIS_LIVE_URL"
      ]
    }
  }
}
