{
  "name": "havayolu",
  "version": "0.22.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@havayolu/web --filter=@havayolu/api --filter=@havayolu/worker",
    "dev:replay": "tsx scripts/dev-replay.mts",
    "record": "tsx tools/src/live/record-cli.ts",
    "smoke:live": "tsx tools/src/live/smoke-cli.ts",
    "coverage:report": "tsx tools/src/arrival-report/report-cli.ts",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:local": "pnpm run format:check && pnpm run check:eol && pnpm run changelog:check && pnpm run typecheck:scripts && pnpm run typecheck:e2e && pnpm run lint:e2e && pnpm run db:check && pnpm run test:scripts && turbo run lint typecheck test build",
    "test:scripts": "vitest run --config scripts/vitest.config.mts",
    "deploy:dokploy": "tsx scripts/deploy-dokploy.mts",
    "changelog": "tsx scripts/changelog.mts",
    "changelog:check": "tsx scripts/changelog.mts --check",
    "stats": "tsx scripts/stats.mts",
    "backup": "tsx scripts/backup.mts",
    "check:eol": "tsx scripts/check-eol.mts",
    "ci:full": "pnpm run ci:local && pnpm run compose:guard && pnpm run test:integration && pnpm run test:migration-upgrade && pnpm run test:e2e",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "lint:e2e": "eslint e2e --max-warnings 0",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:integration": "turbo run test:integration --concurrency=1",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait --wait-timeout 300",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @havayolu/db db:migrate",
    "db:check": "tsx scripts/check-migrations.mts",
    "test:migration-upgrade": "tsx scripts/test-migration-upgrade.mts",
    "compose:guard": "tsx scripts/compose-guard.mts",
    "country-labels:fixture": "tsx tools/src/country-labels/cli.ts fixture && prettier --write tools/fixtures/naturalearth/countries.json",
    "country-labels": "tsx tools/src/country-labels/cli.ts placements && prettier --write packages/shared/src/map/country-label-placements.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.x",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turbo": "2.11.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
