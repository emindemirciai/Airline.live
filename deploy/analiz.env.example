############################################
# ANALIZ (Siteni Analiz Et) - PRODUCTION
# Dokploy → ayrı Compose uygulaması → Environment
############################################
# Repo: https://github.com/emindemirciai/Analyze.Your.Site-Siteni-Analiz-Et- (servis "analyze",
# port 3000, domain analiz.airline.live). Anahtarlar o reponun .env.example'ından alınmıştır.
# Giriş Airline.live API'sinin platform-admin sözleşmesiyle yapılır (infra.md → Analiz).
# Marka geçişi (D-112): analiz.havayolu.live alan adı da bu uygulamada bağlı kalabilir. Site
# kimliği airline.live yeni bir veri serisi başlatır; havayolu.live verisi eski kimlikte kalır.

NODE_ENV=production

ANALYZE_SITE_ID=airline.live
ANALYZE_SITE_NAME=airline.live
ANALYZE_TITLE_TR=Airline.live Siteni Analiz Et
ANALYZE_TITLE_EN=Airline.live Analyze Your Site
ANALYZE_METADATA_TITLE=Airline.live Siteni Analiz Et | Trafik Paneli
ANALYZE_DESCRIPTION=airline.live için gerçek zamanlı trafik analiz paneli
ANALYZE_HEALTH_NAME=Airline.live Siteni Analiz Et

ANALYZE_AUTH_MODE=platform-admin
# Doğrudan yeni API adresi: çapraz alan yönlendirmesinde Authorization başlığı düşer (D-112).
ANALYZE_AUTH_API_URL=https://api.airline.live

# www.airline.live köke yönlendiği için olaylar kökten gelir; www yedek olarak durur. Geçiş
# sırasında eski kök de listede kalır (web env'i değişene kadar olaylar oradan gelir); geçiş
# doğrulanınca https://havayolu.live ve havayolu.live silinir.
ANALYZE_ALLOWED_ORIGINS=https://airline.live,https://www.airline.live,https://havayolu.live
ANALYZE_EVENT_SITES=airline.live,www.airline.live,havayolu.live

ANALYZE_DATA_DIR=/app/data
# Paylaşılan VPS'te bellek için düşük tutulur (uygulamanın varsayılanı 100000).
ANALYZE_MAX_EVENTS=20000
# ip-api.com ücretsiz katmanı ticari kullanıma kapalı ve HTTP'dir (KVKK); kapalı kalır.
ANALYZE_GEO_LOOKUP=false
